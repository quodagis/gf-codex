---
import InteriorHero from "@/components/InteriorHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { links, pages } from "@/data/site";
import { sitePath } from "@/utils/paths";

const page = pages.links;
---

<BaseLayout title="The Gurdjieff Foundation of Los Angeles - Gurdjieff Foundations in North America">
  <InteriorHero eyebrow={page.eyebrow} title={page.title} />
  <section class="px-5 py-20 sm:px-8 lg:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.75fr_1.25fr]">
      <img src={sitePath(page.image)} alt="" class="aspect-[4/5] w-full max-w-md object-cover shadow-2xl shadow-black/10" />
      <div class="grid gap-x-12 gap-y-5 sm:grid-cols-2">
        {links.map(([label, href]) => (
          <a
            href={href}
            target="_blank"
            rel="noreferrer"
            class="border-b border-[#9d9486]/35 py-4 text-sm font-medium leading-6 text-[#4f4a42] transition hover:border-[#8f3d2f] hover:text-[#8f3d2f]"
          >
            {label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
