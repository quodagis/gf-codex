---
import { pages } from "@/data/site";
import ClassicLayout from "@/layouts/ClassicLayout.astro";
import { sitePath } from "@/utils/paths";

const page = pages.foundation;
const title = "Gurdjieff Work in LA";
---

<ClassicLayout
  title={`The Gurdjieff Foundation of Los Angeles - ${title}`}
  description={page.paragraphs[5]}
  current="work"
>
  <article class="classic-page">
    <header class="classic-hero">
      <p class="classic-eyebrow">{page.eyebrow}</p>
      <h1 class="classic-title">{title}</h1>
    </header>

    <div class="classic-split">
      <figure class="classic-photo">
        <img src={sitePath(page.image)} alt="" />
      </figure>
      <div>
        <div class="classic-bodycopy">
          {page.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <figure class="classic-pullquote">
          <blockquote>{page.quote}</blockquote>
          <figcaption>{page.quoteAttribution}</figcaption>
        </figure>
      </div>
    </div>
  </article>
</ClassicLayout>
