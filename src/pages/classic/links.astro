---
import { links, pages } from "@/data/site";
import ClassicLayout from "@/layouts/ClassicLayout.astro";
import { sitePath } from "@/utils/paths";

const page = pages.links;
const title = "Gurdjieff Foundations in North America";
---

<ClassicLayout
  title={`The Gurdjieff Foundation of Los Angeles - ${title}`}
  current="foundations"
>
  <article class="classic-page">
    <header class="classic-hero">
      <p class="classic-eyebrow">{page.eyebrow}</p>
      <h1 class="classic-title">{title}</h1>
    </header>

    <figure class="classic-photo classic-photo-portrait">
      <img src={sitePath(page.image)} alt="" />
    </figure>

    <section class="classic-link-grid" aria-label="Foundations in North America">
      {links.map(([label, href]) => (
        <a href={href} target="_blank" rel="noreferrer">{label}</a>
      ))}
    </section>
  </article>
</ClassicLayout>
