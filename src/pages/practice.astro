---
import InteriorHero from "@/components/InteriorHero.astro";
import StorySection from "@/components/StorySection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/data/site";

const page = pages.practice;
---

<BaseLayout title="The Gurdjieff Foundation of Los Angeles - Groups, Movements, Practical Activities">
  <InteriorHero eyebrow={page.eyebrow} title={page.title} />
  <StorySection {...page} />
</BaseLayout>
