---
import Hero from "@/components/Hero.astro";
import StorySection from "@/components/StorySection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/data/site";
import { sitePath } from "@/utils/paths";

const page = pages.home;
---

<BaseLayout
  title="Gurdjieff Foundation of Los Angeles"
  description={page.paragraphs[5]}
>
  <Hero title={page.title} image={page.image} />
  <StorySection
    paragraphs={page.paragraphs}
    image="/images/biopic.jpg"
    reverse
  />
  <section class="bg-[#5e6958] px-5 py-20 text-white sm:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-3">
      {[
        ["Biography", "/gurdjieff/"],
        ["Gurdjieff Work in LA", "/foundation/"],
        ["Groups, Movements, Practical Activities", "/practice/"],
      ].map(([title, href]) => (
        <a href={sitePath(href)} class="group border-t border-white/30 pt-6">
          <h2 class="serif text-3xl">{title}</h2>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
