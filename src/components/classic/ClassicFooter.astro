---
import { site } from "@/data/site";
---

<footer class="classic-footer">
  <div class="classic-footer-main">
    <div>
      <div class="classic-footer-title">The Gurdjieff Foundation of California, Los Angeles</div>
      <div class="classic-footer-meta">A branch established 1959</div>
    </div>
    <div class="classic-footer-contact">
      <div>{site.phone}</div>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
  <div class="classic-footer-low classic-footer-meta">
    <span>© The Gurdjieff Foundation of California</span>
    <span>Los Angeles · San Francisco · New York · Paris</span>
  </div>
</footer>
