---
interface Props {
  eyebrow?: string;
  title: string;
  dek?: string;
}

const { eyebrow, title, dek } = Astro.props;
---

<section class="bg-[#dfd5c6] px-5 pb-16 pt-36 sm:px-8 lg:pb-24">
  <div class="mx-auto max-w-7xl">
    {eyebrow && <p class="reveal text-xs font-semibold uppercase tracking-[0.28em] text-[#8f3d2f]">{eyebrow}</p>}
    <h1 class="serif reveal mt-5 max-w-4xl text-5xl leading-tight text-[#25231f] sm:text-6xl">{title}</h1>
    {dek && <p class="reveal-delayed mt-6 max-w-2xl text-lg leading-8 text-[#4f4a42]">{dek}</p>}
  </div>
</section>
